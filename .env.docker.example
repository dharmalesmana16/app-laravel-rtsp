# Salin file ini ke ".env" (root proyek) lalu isi nilai produksi.
# Dipakai oleh docker-compose utk substitusi ${VAR}.

# === Edge / domain ===
# Produksi: DOMAIN=rtsp.domainkamu.com  (Caddy auto-TLS Let's Encrypt)
# Lokal    : DOMAIN=:80                  (HTTP saja, tanpa TLS)
DOMAIN=:80
APP_URL=http://localhost

# === Aplikasi ===
APP_KEY=

# === Database ===
DB_DATABASE=rtsp
DB_USERNAME=rtsp
DB_PASSWORD=ganti_password_kuat
DB_ROOT_PASSWORD=ganti_root_password_kuat

# === Stream service ===
STREAM_SERVICE_TOKEN=
MAX_CONCURRENT_STREAMS=16
LOG_LEVEL=info

# === Vite (build-time, di-bake ke asset) ===
VITE_STADIA_API_KEY=
