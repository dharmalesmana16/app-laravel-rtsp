# Salin file ini ke ".env" (root proyek) lalu isi nilai produksi.
# Dipakai oleh docker-compose utk substitusi ${VAR}.

# === Edge / domain ===
# Produksi: DOMAIN=rtsp.domainkamu.com  (Caddy auto-TLS Let's Encrypt)
# Lokal    : DOMAIN=:80                  (HTTP saja, tanpa TLS)
DOMAIN=:80
APP_URL=http://localhost

# === Aplikasi ===
APP_KEY=

# === Database (generate: openssl rand -base64 24) ===
DB_DATABASE=rtsp
DB_USERNAME=rtsp
DB_PASSWORD=ganti_dengan_password_kuat
DB_ROOT_PASSWORD=ganti_dengan_root_password_kuat

# === Stream service ===
STREAM_SERVICE_TOKEN=
MAX_CONCURRENT_STREAMS=16
LOG_LEVEL=info
# URL + token kontrol stream service (resync instan saat CRUD kamera).
# Token kosong => stream service fallback ke STREAM_SERVICE_TOKEN.
STREAM_CONTROL_URL=http://stream:8020
STREAM_CONTROL_TOKEN=

# === Stadia Maps (dipakai server-side oleh tile proxy, tidak diekspos ke browser) ===
STADIA_API_KEY=
